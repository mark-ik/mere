# multi-window smoke: one GenetMultiRunner projected into two windows.
# Self-driven (no OS synthetic input): the app injects each registry command and
# self-captures its own chrome, so there is no focus race across the two windows.
#
# Run headed:
#   MEERKAT_SCENARIO=<...>/multi_window.scn MEERKAT_CAPTURE_DIR=<out> meerkat.exe
# The driver waits for <out>/scenario.done (first line RESULT ok / RESULT fail).

log      primary up
capture  primary            # window 0 (the primary), full chrome
invoke   roster             # act on the primary: open the roster pane
settle   2
capture  primary-roster

spawn                       # open a second window over the shared session
settle   3
assert   windows == 2       # headed: two live OS windows; headless: one projection
capture  leaf @1            # window 1 (the spawned leaf), slim chrome
log      multi-window ok
