{
  "manifest_version": 3,
  "name": "Graphshell",
  "version": "0.1.0",
  "description": "Open Graphshell's local graph and identity surfaces.",
  "permissions": [
    "nativeMessaging"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "graphshell@mere.systems"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open Graphshell"
  }
}
