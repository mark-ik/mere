{
  "manifest_version": 3,
  "name": "Graphshell",
  "version": "0.1.0",
  "description": "Open Graphshell's local graph and identity surfaces.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "optional_permissions": [
    "history",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Graphshell"
  }
}
