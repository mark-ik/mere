# Physics receipt: Energy, LinLog — linear attraction along edges,
# logarithmic repulsion. Its signature is separation: no overlapping bodies,
# communities apart.
assert title GRAPHSHELL H3 READY
assert snap ready == true
dom click [data-command="toggle-physics"]
settle 1
assert snap physics-paused == false
# No arrangement: the boot Spiral's anchor springs would pull under every law.
select #gs-arrangement-select free
dom click [data-command="apply-arrangement"]
settle 1
assert snap layout == free
select #gs-physics-select energy.linlog
dom click [data-command="apply-physics"]
settle 1
assert snap physics-law == energy.linlog
assert snap physics-profile == law.energy
capture physics_energy_start
wait
settle 60
capture physics_energy_settled
wait
settle 300
assert snap layout-overlaps == 0
log physics energy receipt complete
