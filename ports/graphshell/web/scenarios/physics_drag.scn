# --- Anneal ---
log drag Anneal
select #gs-physics-select anneal.davidson-harel
dom click [data-command="apply-physics"]
settle 120
act select-web
settle 1
assert snap physics-law == anneal.davidson-harel
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging ~ -
move-by 220 0
settle 1
release-at
settle 1
# A moving law carries the node within the release frame itself.
assert snap drag-return <= 60
# Anneal is a search that cools: it does not hold a steady energy, so what it
# owes is displacement — the node is not where the drag left it.
settle 300
assert snap drag-return >= 40
assert snap layout-overlaps == 0

# --- Still ---
log drag Still
select #gs-physics-select still.default
dom click [data-command="apply-physics"]
settle 120
act select-web
settle 1
assert snap physics-law == still.default
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging ~ -
move-by 220 0
settle 1
release-at
settle 1
assert snap drag-return <= 20
settle 300
assert snap drag-return <= 5
assert snap physics-energy <= 1
capture physics_drag_still_held
wait
log physics drag receipt complete
