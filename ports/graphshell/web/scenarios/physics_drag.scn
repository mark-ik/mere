# Physics receipt (P4): drag under every law. The node the boot selects is
# pressed, moved 220px right, and released; `drag-return` is how far the law
# has since carried it off the drop point. A law that rests reclaims the node
# (the springs pull it home); a restless law keeps moving instead; Still holds
# it exactly where it was let go.
assert title GRAPHSHELL H3 READY
assert snap ready == true
dom click [data-command="toggle-physics"]
settle 1
assert snap physics-paused == false
select #gs-arrangement-select free
dom click [data-command="apply-arrangement"]
settle 1
assert snap layout == free

# --- Springs ---
log drag Springs
select #gs-physics-select spring.rapier
dom click [data-command="apply-physics"]
settle 120
act select-web
settle 1
assert snap physics-law == spring.rapier
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging ~ -
move-by 220 0
settle 1
release-at
settle 1
assert snap drag-return <= 20
settle 300
assert snap drag-return >= 40
assert snap layout-overlaps == 0
capture physics_drag_springs_reclaimed
wait

