# Physics receipt (P4): adding a node under every law. Each block adds one
# node at a point on the canvas and lets the law answer. The donor's two
# contracts are what is being checked: a structural change reheats the
# layout (the new body is not left frozen where it landed), and the graph
# never ends up with bodies on top of each other. Under Still the reheat is
# a no-op by construction — the law holds everything, including the newcomer.
assert title GRAPHSHELL H3 READY
assert snap ready == true
dom click [data-command="toggle-physics"]
settle 1
assert snap physics-paused == false
select #gs-arrangement-select free
dom click [data-command="apply-arrangement"]
settle 1
assert snap layout == free
assert snap canvas-nodes == 11

# --- Springs ---
log add Springs
select #gs-physics-select spring.rapier
dom click [data-command="apply-physics"]
settle 120
assert snap physics-law == spring.rapier
add-node 300 260 mere://p4/add/springs
settle 1
assert snap canvas-nodes == 12
settle 300
assert snap layout-overlaps == 0
assert snap physics-energy <= 500
capture physics_add_springs
wait

# --- Charge ---
log add Charge
select #gs-physics-select charge.barnes-hut
dom click [data-command="apply-physics"]
settle 120
assert snap physics-law == charge.barnes-hut
add-node 320 272 mere://p4/add/charge
settle 1
assert snap canvas-nodes == 13
settle 300
assert snap layout-overlaps == 0

