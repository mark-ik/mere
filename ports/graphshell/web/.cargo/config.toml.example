# Copy to .cargo/config.toml (gitignored) — or merge into yours.
#
# The wasm32 identity stack (personae -> getrandom 0.3) needs this cfg; the
# `wasm_js` feature alone is inert. Without it the `webrtc-browser` feature
# of graphshell does not compile for wasm32-unknown-unknown.
[target.wasm32-unknown-unknown]
rustflags = ['--cfg', 'getrandom_backend="wasm_js"']
